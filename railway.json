{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "BackEnd/Dockerfile",
    "watchPatterns": [
      "BackEnd/src/**",
      "BackEnd/pom.xml",
      "BackEnd/Dockerfile"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
